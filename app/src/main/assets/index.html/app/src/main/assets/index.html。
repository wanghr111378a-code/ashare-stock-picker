<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>A股智能选股器</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101827;color:#edf2fa;font-family:Arial,"Microsoft YaHei",sans-serif}
header{padding:20px 16px;background:#17243a}
h2{margin:0 0 8px;font-size:22px}
.small{font-size:12px;color:#aab8cc}
.tabs{display:flex;gap:8px;padding:12px;overflow:auto}
button{border:0;border-radius:9px;padding:11px 13px;background:#263850;color:white;font-size:14px}
button.active{background:#1677ff}
main{padding:12px}
.panel{background:#19283e;border-radius:13px;padding:14px;margin-bottom:12px}
h3{margin:0 0 12px;font-size:17px}
input,select{width:100%;padding:12px;margin:5px 0 10px;border-radius:8px;border:1px solid #40536c;background:#101c2e;color:white;font-size:15px}
label{font-size:13px;color:#b8c7da}
.primary{background:#1677ff;width:100%;margin-top:8px}
.danger{background:#9b3545}
.stock{border-top:1px solid #34465e;padding:12px 0}
.stock strong{font-size:16px}
.score{float:right;color:#54d69b;font-weight:bold}
.muted{color:#9eafc5;font-size:12px}
.notice{background:#483b20;color:#ffdc8a;padding:10px;border-radius:8px;font-size:12px;line-height:1.6}
</style>
</head>
<body>
<header>
<h2>📈 A股智能选股器</h2>
<div class="small">V1.0 · 三大策略独立运行 · 手机版</div>
</header>
<div class="tabs" id="tabs">
<button class="active" onclick="switchStrategy(0)">北京炒家</button>
<button onclick="switchStrategy(1)">退学炒股</button>
<button onclick="switchStrategy(2)">炒股养家</button>
</div>
<main>
<div class="notice">行情状态：手动录入模式。当前不会自动获取实时行情，所有数据由用户输入，请勿将示例数据作为真实行情。</div>
<div class="panel">
<h3 id="strategyTitle">北京炒家策略</h3>
<div class="muted" id="strategyDesc">独立股票池 · 独立评分 · 独立记录</div>
</div>
<div class="panel">
<h3>添加股票</h3>
<label>股票代码</label>
<input id="code" placeholder="例如：600000">
<label>股票名称</label>
<input id="name" placeholder="例如：浦发银行">
<label>当前价格（元）</label>
<input id="price" type="number" step="0.01" placeholder="例如：10.50">
<label>今日涨幅（%）</label>
<input id="change" type="number" step="0.01" placeholder="例如：3.5">
<label>成交额（万元）</label>
<input id="amount" type="number" placeholder="例如：50000">
<button class="primary" onclick="addStock()">加入当前策略股票池</button>
</div>
<div class="panel">
<h3>当前策略选股榜单</h3>
<div class="muted">根据录入数据计算参考分数，不代表买入建议。</div>
<div id="stockList"></div>
<button class="primary" onclick="rankStocks()">重新评分排序</button>
</div>
<div class="panel">
<h3>当前策略数据管理</h3>
<button onclick="exportData()">导出全部数据</button>
<button class="danger" onclick="clearCurrent()">清空当前策略</button>
<div class="muted" style="margin-top:10px">三个策略分别保存，切换策略不会混用股票池。</div>
</div>
</main>
<script>
const keys=["bj","tx","jy"];
const titles=["北京炒家策略","退学炒股策略","炒股养家策略"];
const desc=[
"偏重强势股、涨停表现、成交活跃度的公开理念量化近似。",
"偏重市场情绪、短线强度、价格波动的公开理念量化近似。",
"偏重市场主线、热点持续性、资金关注度的公开理念量化近似。"
];
let current=0;
let pools=JSON.parse(localStorage.getItem("ashare_pools")||'{"bj":[],"tx":[],"jy":[]}');
function save(){localStorage.setItem("ashare_pools",JSON.stringify(pools))}
function switchStrategy(i){
current=i;
document.querySelectorAll("#tabs button").forEach((b,n)=>b.classList.toggle("active",n===i));
document.getElementById("strategyTitle").textContent=titles[i];
document.getElementById("strategyDesc").textContent=desc[i];
render();
}
function addStock(){
let code=document.getElementById("code").value.trim();
let name=document.getElementById("name").value.trim();
let price=Number(document.getElementById("price").value);
let change=Number(document.getElementById("change").value);
let amount=Number(document.getElementById("amount").value);
if(!/^\d{6}$/.test(code)||!name||price<=0||!Number.isFinite(change)||amount<0){
alert("请正确填写6位股票代码、名称、价格、涨幅和成交额");return;
}
pools[keys[current]].push({code,name,price,change,amount,time:new Date().toLocaleString()});
save();render();
["code","name","price","change","amount"].forEach(id=>document.getElementById(id).value="");
}
function score(s){
let momentum=Math.max(0,Math.min(40,s.change*5));
let activity=Math.max(0,Math.min(30,Math.log10(s.amount+1)*5));
let strength=s.change>0?20:0;
return Math.round(Math.min(100,momentum+activity+strength));
}
function render(){
let arr=pools[keys[current]];
document.getElementById("stockList").innerHTML=arr.length?arr.map((s,i)=>`
<div class="stock">
<span class="score">${score(s)}分</span>
<strong>${s.name}</strong> <span class="muted">${s.code}</span>
<div style="margin-top:7px">价格：${s.price.toFixed(2)}元　涨幅：${s.change}%</div>
<div class="muted">成交额：${s.amount}万元</div>
<div class="muted">录入时间：${s.time}</div>
<button class="danger" onclick="removeStock(${i})">删除</button>
</div>`).join(""):"<p class='muted'>当前策略股票池为空，请添加股票。</p>";
}
function rankStocks(){
pools[keys[current]].sort((a,b)=>score(b)-score(a));save();render();
}
function removeStock(i){pools[keys[current]].splice(i,1);save();render()}
function clearCurrent(){
if(confirm("确定清空当前策略的全部股票吗？")){
pools[keys[current]]=[];save();render();
}
}
function exportData(){
let blob=new Blob([JSON.stringify(pools,null,2)],{type:"application/json"});
let url=URL.createObjectURL(blob);
let a=document.createElement("a");a.href=url;a.download="ashare-stock-data.json";a.click();
URL.revokeObjectURL(url);
}
render();
</script>
</body>
</html>
